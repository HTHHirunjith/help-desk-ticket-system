# Local development only. Copy this file to `.env` and fill in values.
# Do not commit `.env`. Git ignores it.

DATABASE_URL=jdbc:postgresql://host:5432/dbname
DATABASE_USERNAME=your-username
DATABASE_PASSWORD=your-password
JWT_SECRET=replace-with-a-long-random-secret

# ----------------------------------------------------------------
# Development user seeding
# Set SEED_ENABLED=true ONLY in local development environments.
# Never enable in production.
# ----------------------------------------------------------------
SEED_ENABLED=false

# Required when SEED_ENABLED=true.
# Passwords must meet the application's validation rules.
# Leave blank here; provide real values in your local .env only.
DEV_ADMIN_PASSWORD=
DEV_AGENT_PASSWORD=
DEV_USER_PASSWORD=

# Optional: override the default development email addresses.
# DEV_ADMIN_EMAIL=admin@helpdesk.dev
# DEV_AGENT_EMAIL=agent@helpdesk.dev
# DEV_USER_EMAIL=user@helpdesk.dev

# ----------------------------------------------------------------
# Email configuration
# Real SMTP credentials are required to actually send onboarding emails
# to newly created SUPPORT_AGENT and ADMIN accounts.
# ----------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
